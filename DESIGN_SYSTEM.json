{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Market Sync Design System & Technical Specification",
  "version": "1.4.2",
  "specificationVersion": "2.0.0",
  "project": {
    "name": "Market Sync",
    "appId": "market-sync",
    "author": "Mahabub H. Aabir",
    "email": "maha_bub@outlook.com",
    "repository": "https://github.com/mahabubaabir/market-sync",
    "license": "MIT",
    "targetPlatform": "Linux Mint 21/22+ (Cinnamon 5.x/6.x), Ubuntu 22.04/24.04+ (GNOME/XFCE/Cinnamon)",
    "description": "Global Trading Session & Economic News Tracker for Linux Mint / Ubuntu (Cinnamon) featuring Material UI glassmorphism, top panel applet, and live multi-impact economic calendar."
  },
  "designSystem": {
    "philosophy": {
      "name": "Material UI Frosted Glass (Glassmorphism)",
      "principles": [
        "Translucent frosted glass blending smoothly into any desktop wallpaper",
        "Vibrant neon glowing accents for live/active trading sessions",
        "Crisp silvery-white legible muted tones for closed/off trading sessions",
        "High information density with zero clutter and minimum horizontal panel footprint",
        "Micro-animations, circular timer arcs, and instant tactile feedback"
      ],
      "window": {
        "width": 410,
        "borderRadius": "14px",
        "backdropFilter": "blur(20px)",
        "windowFlags": [
          "Qt.WindowType.Tool",
          "Qt.WindowType.FramelessWindowHint",
          "Qt.WindowType.WindowStaysOnTopHint"
        ],
        "attributes": [
          "Qt.WidgetAttribute.WA_TranslucentBackground"
        ]
      }
    },
    "colorTokens": {
      "darkGlassTheme": {
        "window": {
          "background": "rgba(16, 20, 30, 0.88)",
          "border": "1px solid rgba(255, 255, 255, 0.08)",
          "borderRadius": "14px"
        },
        "card": {
          "backgroundDefault": "rgba(28, 34, 48, 0.70)",
          "backgroundActive": "rgba(20, 42, 30, 0.65)",
          "borderDefault": "1px solid rgba(255, 255, 255, 0.06)",
          "borderActive": "1.5px solid #30d158",
          "borderHover": "1px solid rgba(255, 255, 255, 0.16)",
          "borderRadius": "10px",
          "boxShadow": "0 8px 24px rgba(0, 0, 0, 0.45)"
        },
        "text": {
          "primary": "#f1f5f9",
          "secondary": "#94a3b8",
          "muted": "#64748b",
          "activeGreen": "#30d158",
          "activeCyan": "#38bdf8",
          "closedSlate": "#cbd5e1"
        },
        "dividers": "rgba(255, 255, 255, 0.08)",
        "inputs": {
          "background": "rgba(255, 255, 255, 0.06)",
          "backgroundHover": "rgba(255, 255, 255, 0.10)",
          "backgroundSelected": "rgba(56, 189, 248, 0.22)",
          "border": "1px solid rgba(255, 255, 255, 0.12)",
          "borderSelected": "1px solid #38bdf8"
        }
      },
      "lightGlassTheme": {
        "window": {
          "background": "rgba(250, 252, 255, 0.88)",
          "border": "1px solid rgba(0, 0, 0, 0.08)",
          "borderRadius": "14px"
        },
        "card": {
          "backgroundDefault": "rgba(255, 255, 255, 0.85)",
          "backgroundActive": "rgba(236, 253, 245, 0.90)",
          "borderDefault": "1px solid rgba(0, 0, 0, 0.06)",
          "borderActive": "1.5px solid #16a34a",
          "borderHover": "1px solid rgba(0, 0, 0, 0.14)",
          "borderRadius": "10px",
          "boxShadow": "0 8px 20px rgba(0, 0, 0, 0.08)"
        },
        "text": {
          "primary": "#0f172a",
          "secondary": "#475569",
          "muted": "#94a3b8",
          "activeGreen": "#16a34a",
          "activeCyan": "#0284c7",
          "closedSlate": "#334155"
        },
        "dividers": "rgba(0, 0, 0, 0.08)"
      },
      "newsImpact": {
        "High": {
          "color": "#ef4444",
          "name": "High Impact",
          "dark": {
            "background": "rgba(239, 68, 68, 0.18)",
            "border": "1px solid rgba(239, 68, 68, 0.40)",
            "text": "#ef4444"
          },
          "light": {
            "background": "#fee2e2",
            "border": "1px solid #fca5a5",
            "text": "#b91c1c"
          }
        },
        "Medium": {
          "color": "#f97316",
          "name": "Medium Impact",
          "dark": {
            "background": "rgba(249, 115, 22, 0.18)",
            "border": "1px solid rgba(249, 115, 22, 0.40)",
            "text": "#f97316"
          },
          "light": {
            "background": "#ffedd5",
            "border": "1px solid #fdba74",
            "text": "#c2410c"
          }
        },
        "Low": {
          "color": "#eab308",
          "name": "Low Impact",
          "dark": {
            "background": "rgba(234, 179, 8, 0.18)",
            "border": "1px solid rgba(234, 179, 8, 0.40)",
            "text": "#eab308"
          },
          "light": {
            "background": "#fef9c3",
            "border": "1px solid #fde047",
            "text": "#854d0e"
          }
        },
        "Holiday": {
          "color": "#a1a1aa",
          "name": "Non-economic / Holiday",
          "dark": {
            "background": "rgba(161, 161, 170, 0.15)",
            "border": "1px solid rgba(161, 161, 170, 0.30)",
            "text": "#a1a1aa"
          }
        }
      },
      "currencyColors": {
        "USD": "#38bdf8",
        "EUR": "#10b981",
        "GBP": "#c084fc",
        "JPY": "#f87171",
        "AUD": "#fb923c",
        "CAD": "#e879f9",
        "CHF": "#e2e8f0",
        "NZD": "#34d399"
      }
    },
    "typography": {
      "fontFamilyPrimary": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, sans-serif",
      "fontFamilyMonospace": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
      "scale": {
        "heroSignedCountdown": {
          "fontSize": "22px",
          "fontWeight": "Bold",
          "letterSpacing": "-0.5px"
        },
        "marketName": {
          "fontSize": "13px",
          "fontWeight": "600",
          "letterSpacing": "0px"
        },
        "marketLocalTime": {
          "fontSize": "11px",
          "fontWeight": "500",
          "color": "#94a3b8"
        },
        "brandTitle": {
          "fontSize": "9px",
          "fontWeight": "Bold",
          "letterSpacing": "1.0px",
          "textTransform": "uppercase"
        },
        "newsEventTime": {
          "fontSize": "11px",
          "fontWeight": "Bold",
          "fontFamily": "Monospace"
        },
        "newsEventTitle": {
          "fontSize": "11px",
          "fontWeight": "Normal"
        },
        "badge": {
          "fontSize": "9px",
          "fontWeight": "Bold",
          "padding": "2px 5px",
          "borderRadius": "4px"
        }
      }
    },
    "components": {
      "marketCard": {
        "grid": "2x2 Layout",
        "fixedHeight": 82,
        "padding": "8px 10px",
        "elements": [
          "Landmark vector badge with colored accent circular glow (size: 26px)",
          "Market Name & Local Time in upper row",
          "Big Signed Countdown (+04:05 / -00:35) in bottom row",
          "Mini Status Capsule Pill: OPEN (neon green) or CLOSED (glass slate)",
          "Mini Progress Ring Timer arc indicating elapsed session progress (20px)"
        ]
      },
      "brandBar": {
        "fixedHeight": 32,
        "padding": "0 10px",
        "elements": [
          "Transparent twin-arrow app icon (20px, assets/icon.svg)",
          "MARKET SYNC uppercase title",
          "Drawer collapse/expand button (▾ / ▴)",
          "Notification toggle bell button (🔔)",
          "Preferences gear icon button (⚙️)"
        ]
      },
      "newsDrawer": {
        "header": {
          "title": "UP NEXT",
          "filterChips": [
            "All",
            "🔴 High",
            "🟠 Med",
            "🟡 Low"
          ]
        },
        "scrollArea": {
          "height": 175,
          "rowSpacing": 5,
          "rowHeight": 28
        },
        "row": {
          "background": "rgba(255, 255, 255, 0.03)",
          "border": "1px solid rgba(255, 255, 255, 0.04)",
          "borderRadius": "6px",
          "elements": [
            "Relative time countdown badge (e.g., '15m ago', '2h 10m')",
            "Impact capsule badge (HIGH, MED, LOW)",
            "Currency code badge (USD, EUR, GBP, JPY, etc.)",
            "Economic event title"
          ]
        },
        "bottomBar": {
          "dateLabel": "e.g., '19 Sep'",
          "collapseButton": "▴"
        }
      },
      "preferencesWindow": {
        "width": 380,
        "cards": [
          "Launch at Login Checkbox",
          "Menu Bar & Top Panel Display Card with Live Preview",
          "Layout Segment: [ Compact Symbols | Standard Names ]",
          "Show Time As Segment: [ Local Time | Countdown ]",
          "Format Segment: [ 12h | 24h ]",
          "Panel Sessions Segment: [ Active Only | Active + Next | All ]",
          "Standalone Tray Icon Checkbox: [ Show standalone tray icon alongside panel applet ]",
          "Market Tracking Table (London, New York, Sydney, Tokyo, NYSE) with 3-way routing: [ none | popup | + panel ]",
          "Footer: Market Sync Logo, Version, Developer Metadata (Mahabub H. Aabir), and Quit App button"
        ]
      }
    },
    "brandLogo": {
      "concept": "Two opposing sync arrows converging on an illuminated core (transparent canvas, no squircle/clock container since v1.4.2)",
      "viewBox": "0 0 100 100",
      "files": ["assets/icon.svg", "assets/logo.svg"],
      "upperArrow": {
        "gradientId": "syncGrad1",
        "startColor": "#67e8f9",
        "endColor": "#6366f1",
        "path": "M50 9 A41 41 0 0 1 91 50 A41 41 0 0 1 80 78 L68 66 A24 24 0 0 0 74 50 A24 24 0 0 0 50 26 L50 38 L28 19 L50 0 Z"
      },
      "lowerArrow": {
        "gradientId": "syncGrad2",
        "startColor": "#34d399",
        "endColor": "#22d3ee",
        "path": "M50 91 A41 41 0 0 1 9 50 A41 41 0 0 1 20 22 L32 34 A24 24 0 0 0 26 50 A24 24 0 0 0 50 74 L50 62 L72 81 L50 100 Z"
      },
      "centerCore": {
        "outerCircle": "cx=50 cy=50 r=7 fill=#ffffff",
        "innerCircle": "cx=50 cy=50 r=4 fill=#38bdf8"
      },
      "packaging": "tools/render_icons.py renders assets/icon.svg into all hicolor PNG sizes"
    },
    "landmarks": {
      "LONDON": {
        "city": "London",
        "symbol": "LON",
        "landmark": "London Eye",
        "description": "Ferris wheel structure with rotating viewing capsules and support spoke hub",
        "accentColor": "#8ecd76"
      },
      "NEW_YORK": {
        "city": "New York",
        "symbol": "NYC",
        "landmark": "Statue of Liberty",
        "description": "Liberty torch flame radiating upward with robed silhouette",
        "accentColor": "#c792ea"
      },
      "SYDNEY": {
        "city": "Sydney",
        "symbol": "SYD",
        "landmark": "Sydney Opera House",
        "description": "Concentric expressionist arched shell sails billowing over harbor waters",
        "accentColor": "#4da3ff"
      },
      "TOKYO": {
        "city": "Tokyo",
        "symbol": "TYO",
        "landmark": "Torii Gate",
        "description": "Traditional Japanese Shinto shrine gate with dual pillars and lintel beams",
        "accentColor": "#ff6b6b"
      }
    }
  },
  "cinnamonAppletSpecification": {
    "uuid": "market-sync@cinnamon",
    "baseClass": "Applet.TextApplet",
    "textOnly": true,
    "icon": {
      "format": "PNG (128x128) & SVG",
      "file": "icon.png / icon.svg",
      "usage": "Applets-manager catalog list only; the live top-bar widget has no icon actor"
    },
    "markup": {
      "pangoEnabled": true,
      "activeSessionFormat": "<span weight=\"bold\" foreground=\"#30d158\">● {SYMBOL} {COUNTDOWN}</span>",
      "closedSessionFormat": "<span foreground=\"#cbd5e1\">○ {SYMBOL} {COUNTDOWN}</span>",
      "separator": "  ",
      "sample": "<span weight=\"bold\" foreground=\"#30d158\">● LON +04:05</span>  <span foreground=\"#cbd5e1\">○ NYC -00:35</span>"
    },
    "statusFileLocation": "~/.cache/market-sync/panel_status.json",
    "statusFileSchema": {
      "label": "Plain text fallback string",
      "markup": "Rich Pango markup with bold green open sessions and silvery closed sessions",
      "tooltip": "Multi-line summary of all active sessions and local times",
      "is_open": "Boolean indicating if any market is currently in active session"
    },
    "interactions": {
      "leftClick": "Executes 'market-sync --toggle' via IPC to display/hide Material Glass dropdown window",
      "rightClick": "Opens Cinnamon AppletPopupMenu with [ Toggle Panel, Preferences..., Separator, Quit Market Sync ]"
    },
    "singleWidgetCoordination": {
      "description": "Both-in-one: the standalone Qt QSystemTrayIcon stays visible alongside the text-only applet while show_standalone_tray is true (default); unchecking it in Preferences gives applet-only.",
      "trayStyles": {
        "logo": "Recommended compact 24px twin-arrow mark with open/closed status dot; always legible in Cinnamon's tray.",
        "text": "Wide rendered session strip; Cinnamon's tray can squeeze wide pixmaps into a blank-looking slot."
      }
    }
  },
