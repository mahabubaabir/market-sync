  "ipcSpecification": {
    "server": "QLocalServer",
    "socketName": "market_sync_ipc",
    "commands": {
      "toggle": "Toggles panel window visibility and raises to top under Cinnamon panel",
      "show": "Shows panel window directly below top bar",
      "hide": "Hides panel window",
      "preferences": "Opens Market Sync Preferences dialog",
      "quit": "Terminates background daemon cleanly and frees IPC lock"
    }
  },
  "fileSystemPaths": {
    "userConfig": "~/.config/market-sync/settings.json",
    "autostart": "~/.config/autostart/market-sync.desktop",
    "cacheDirectory": "~/.cache/market-sync/",
    "panelStatus": "~/.cache/market-sync/panel_status.json",
    "newsCache": "~/.cache/market-sync/news_events.json",
    "lockFile": "~/.cache/market-sync/app.lock",
    "cinnamonApplet": "~/.local/share/cinnamon/applets/market-sync@cinnamon/"
  }
}
