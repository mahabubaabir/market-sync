#!/bin/bash
# Market Sync launcher (installed as /usr/bin/market-sync).
# - Detaches from the terminal so closing it never kills the app.
# - Restarts after a crash (up to 3 times); clean quit ends the loop.
APP_DIR="/opt/market-sync"
# Never write the log into another user's $HOME when elevated (a root-owned
# log would break later user writes); root gets its own cache dir.
if [ "$(id -u)" = "0" ]; then
  LOG_DIR="/root/.cache/market-sync"
else
  LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/market-sync"
fi
mkdir -p "$LOG_DIR" 2>/dev/null || true
LOG="$LOG_DIR/app.log"

# rotate at 1 MB
if [ -f "$LOG" ] && [ "$(stat -c%s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
  mv -f "$LOG" "$LOG.1" 2>/dev/null || true
fi

run_loop() {
  cd "$APP_DIR" 2>/dev/null || exit 1
  local code=0
  local attempt
  for attempt in 1 2 3; do
    /usr/bin/python3 "$APP_DIR/main.py" "$@" >>"$LOG" 2>&1
    code=$?
    if [ "$code" -eq 0 ]; then
      exit 0
    fi
    sleep 2
  done
  exit "$code"
}

# Informational and IPC commands must run in the foreground so their
# output and exit codes reach the caller. (Previously EVERY terminal
# invocation detached and swallowed stdout, so even `market-sync --version`
# printed nothing — its output ended up in app.log instead.)
case "${1:-}" in
  --version|--check-update|--help|-h|--cli|--once|\
  --toggle|--show|--hide|--preferences|--quit|--market)
    exec /usr/bin/python3 "$APP_DIR/main.py" "$@"
    ;;
esac

# Launching from a terminal? Detach so the app survives the terminal closing.
if [ -t 2 ]; then
  setsid /usr/bin/market-sync "$@" >/dev/null 2>&1 < /dev/null &
  disown 2>/dev/null || true
  echo "Market Sync started in the background (log: $LOG)"
  exit 0
fi

run_loop "$@"
